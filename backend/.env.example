# Local development settings. Copy to .env, which git ignores. Each line shows a value that
# suits running on your own machine; the comment gives the built-in default where it differs.

# Serve /docs and /openapi.json.
FOOD_API_DOCS_ENABLED=true

# One SQLite file, relative to the directory the server is started from.
FOOD_API_DATABASE_URL=sqlite:///food-reservations.db

# How long a request waits for another write to finish before answering 503.
FOOD_API_DATABASE_BUSY_TIMEOUT_MS=5000

# Origins the browser may send changes from: the frontend's development server.
FOOD_API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Let the session cookie travel over plain HTTP. Default: true (HTTPS only). This is the
# explicit development setting; it is ignored once the business settings are live.
FOOD_API_COOKIE_SECURE=false

# Session limits in seconds: 30 idle minutes, 12 hours in total, 15 minutes before sign-in.
FOOD_API_SESSION_IDLE_SECONDS=1800
FOOD_API_SESSION_ABSOLUTE_SECONDS=43200
FOOD_API_PRE_AUTH_SECONDS=900

# Sign-in lock: this many failures within the window refuse every attempt until it passes.
FOOD_API_SIGN_IN_MAX_FAILURES=5
FOOD_API_SIGN_IN_WINDOW_SECONDS=900

# Not read by the server, which keeps only a hash of the token. If you want the token that
# `food-admin setup-local` printed kept on this machine, this is a place for it: `.env` is
# never committed.
# LOCAL_ADMIN_TOKEN=
